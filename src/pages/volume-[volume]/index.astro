---
// removed db imports (disable database for Vercel build)

export const getStaticPaths = (async () => {
  return [];
}) satisfies GetStaticPaths;

const { volume: volumeNumber } = Astro.params;

if (!volumeNumber) {
  return Astro.redirect("/");
}

const volume = null;
const chaptersFromVolume = [];

if (!volumeNumber) {
  return Astro.redirect("/");
}
---

<MainLayout
  tagline={`Volume ?`}
  metadata={{
    title: `Read Vagabond Manga | Volume ${"?"}`,
    description: `Read Vagabond Volume ${"?"} online for free. Contains ${0} chapters (${0}-${0}). High-quality manga scans from Takehiko Inoue's masterpiece.`,
    keywords: [
      `Vagabond Volume ${"?"}`,
      `Vagabond chapters ${0}-${0}`,
      "Takehiko Inoue",
      "read manga online",
    ],
    endpoint: `/volume-${"?"}`,
  }}
>
  <main class="pt-20">
    <section
      class="bg-white dark:bg-black border-b border-gray-200 dark:border-neutral-800 min-h-[calc(100vh-5rem)]"
    >
      <div class="max-w-7xl mx-auto px-4 md:px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-15 h-full">
          <div class="flex flex-col lg:w-80">
            <VolumeCover volume={"?"} />
            <VolumeInformation
              volume={"?"}
              chapterCount={0}
              firstChapter={0 ?? 0}
              lastChapter={0 ?? 0}
              releaseDate={0}
            />
          </div>
          <ChapterList
            volumeNumber={"?"}
            chapters={chaptersFromVolume}
          />
        </div>
      </div>
    </section>
  </main>
</MainLayout>
